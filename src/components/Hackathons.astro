---
import { hackathons } from "../data/hackathons";

interface Props {
  compactHeader?: boolean;
}

const { compactHeader = false } = Astro.props;

const highlightedTerms = [
  "HDBSCAN",
  "UMAP",
  "embeddings",
  "RAG",
  "re-ranking",
  "BigQuery",
  "machine learning",
  "deep learning",
  "natural language",
  "Analyse patent",
];

const escapedTerms = highlightedTerms
  .sort((a, b) => b.length - a.length)
  .map((term) => term.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
const highlightPattern = new RegExp(`(${escapedTerms.join("|")})`, "gi");
const highlightSet = new Set(highlightedTerms.map((term) => term.toLowerCase()));

function highlightText(text: string) {
  return text.split(highlightPattern).filter(Boolean).map((part) => ({
    text: part,
    highlight: highlightSet.has(part.toLowerCase()),
  }));
}
---

<section class="section" aria-labelledby="hackathons-title">
  {!compactHeader && (
    <div class="section__header">
      <div>
        <p class="eyebrow">Applied projects</p>
        <h2 id="hackathons-title">Hackathons</h2>
        <p class="section__intro">
          Short-form applied projects built under time pressure: product framing, data work, and decision-oriented
          prototypes.
        </p>
      </div>
      <p class="section__meta">{hackathons.length} selected</p>
    </div>
  )}

  <div class="stack-list">
    {hackathons.map((hackathon) => (
      <details class="detail-card">
        <summary class="detail-card__summary">
          <div>
            <p class="detail-card__context">{hackathon.context}</p>
            <h3>{hackathon.name}</h3>
          </div>
          <div class="detail-card__side">
            <span class="detail-card__toggle" aria-hidden="true">Details</span>
          </div>
        </summary>

        <div class="detail-card__content detail-card__content--single">
          <p>
            {highlightText(hackathon.summary).map((part) =>
              part.highlight ? <mark class="keyword-mark">{part.text}</mark> : part.text
            )}
          </p>

          <div class="fact-grid">
            <p><span>Focus</span>{hackathon.focus}</p>
            <p><span>Team</span>{hackathon.team}</p>
            {hackathon.result && <p><span>Outcome</span>{hackathon.result}</p>}
          </div>

          <ul class="impact-list">
            {hackathon.impactPoints.slice(0, 2).map((point) => (
              <li>
                {highlightText(point).map((part) =>
                  part.highlight ? <mark class="keyword-mark">{part.text}</mark> : part.text
                )}
              </li>
            ))}
          </ul>

          {hackathon.links && hackathon.links.length > 0 && (
            <div class="detail-card__links">
              {hackathon.links.map((link) => (
                <a href={link.href} class="text-link" target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ))}
            </div>
          )}

          {hackathon.video && (
            <div class="detail-card__video">
              <iframe
                src={hackathon.video.embedUrl}
                title={hackathon.video.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          )}

          <div class="tag-list" aria-label="Project topics">
            {hackathon.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
          </div>
        </div>
      </details>
    ))}
  </div>
</section>
