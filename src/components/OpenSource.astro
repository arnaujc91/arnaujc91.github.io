---
import { openSourceProjects } from "../data/opensource";
import { makeHighlighter } from "../lib/highlight";

interface Props {
  compactHeader?: boolean;
}

const { compactHeader = false } = Astro.props;

const highlightedTerms = [
  "Reinforcement learning",
  "PyTorch",
  "policy internals",
  "actor/critic typing",
  "actor",
  "critic",
  "policy forward interfaces",
  "distribution handling",
  "distribution mode",
  "Batch API",
  "Batch key API",
  "deterministic action selection",
  "Forecasting",
  "ARIMA",
  "statsmodels",
  "statsforecast",
  "pandas",
  "adapter compatibility",
  "MCP",
  "coding agent",
  "pywebview",
  "macOS AppKit",
  "AppKit",
  "Dock",
  "tray/status-bar",
  "window state management",
];

const highlightText = makeHighlighter(highlightedTerms);

function projectNumber(index: number) {
  return String(index + 1).padStart(2, "0");
}
---

<section
  class="section collection-section"
  aria-labelledby={!compactHeader ? "open-source-title" : undefined}
  aria-label={compactHeader ? "Open Source projects" : undefined}
>
  {!compactHeader && (
    <div class="section__header">
      <div>
        <p class="eyebrow">Community engineering</p>
        <h2 id="open-source-title">Open Source</h2>
        <p class="section__intro">
          Selected contributions to production-grade open source libraries, focused on developer experience,
          maintainability, and practical machine learning workflows.
        </p>
      </div>
      <p class="section__meta">{openSourceProjects.length} selected projects</p>
    </div>
  )}

  <div class="oss-list">
    {openSourceProjects.map((project, index) => (
      <details class="detail-card oss-card">
        <summary class="detail-card__summary oss-card__summary">
          <span class="oss-card__index" aria-hidden="true">{projectNumber(index)}</span>

          <div class="oss-card__main">
            <p class="oss-card__role">{project.role}</p>
            <h3>{project.name}</h3>
            <p class="oss-card__summary-text">
              {highlightText(project.summary).map((part) =>
                part.highlight ? <mark class="keyword-mark">{part.text}</mark> : part.text
              )}
            </p>

            <div class="tag-list oss-card__tags" aria-label={`${project.name} topics`}>
              {project.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
            </div>
          </div>

          <div class="oss-card__cue">
            <span>{project.links?.length ?? 0} merged PRs</span>
            <span class="detail-card__toggle" aria-hidden="true">Details</span>
          </div>
        </summary>

        <div class="detail-card__content oss-card__content">
          <div>
            <p class="oss-card__label">Selected impact</p>
            <ul class="impact-list">
              {project.impactPoints.map((point) => (
                <li>
                  {highlightText(point).map((part) =>
                    part.highlight ? <mark class="keyword-mark">{part.text}</mark> : part.text
                  )}
                </li>
              ))}
            </ul>
          </div>

          <aside class="detail-card__aside" aria-label={`${project.name} metadata`}>
            <dl class="meta-list">
              <div>
                <dt>Stack</dt>
                <dd>
                  {highlightText(project.tech).map((part) =>
                    part.highlight ? <mark class="keyword-mark">{part.text}</mark> : part.text
                  )}
                </dd>
              </div>

              {project.link && (
                <div>
                  <dt>Repository</dt>
                  <dd>
                    <a href={project.link} class="text-link" target="_blank" rel="noopener noreferrer">
                      GitHub
                    </a>
                  </dd>
                </div>
              )}

              {project.links && project.links.length > 0 && (
                <div>
                  <dt>Pull requests</dt>
                  <dd class="oss-card__links">
                    {project.links.map((link) => (
                      <a href={link.href} class="text-link" target="_blank" rel="noopener noreferrer">
                        {highlightText(link.label).map((part) =>
                          part.highlight ? <mark class="keyword-mark">{part.text}</mark> : part.text
                        )}
                      </a>
                    ))}
                  </dd>
                </div>
              )}
            </dl>
          </aside>
        </div>
      </details>
    ))}
  </div>
</section>
